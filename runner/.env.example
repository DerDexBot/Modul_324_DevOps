# ============================================================
# GitHub Self-Hosted Runner – Konfiguration
# ============================================================
# Kopiere diese Datei zu ".env" und fülle die Werte aus.
# Die ".env"-Datei ist in .gitignore eingetragen (keine Secrets committen!).

# GitHub Repository URL
# Beispiel: https://github.com/DerDexBot/Modul_324_DevOps
REPO_URL=https://github.com/DerDexBot/REPO_NAME

# GitHub Personal Access Token (PAT)
# Erstellen: GitHub > Settings > Developer Settings > Personal Access Tokens > Tokens (classic)
# Benötigte Scopes: repo (vollständig)
# Der PAT ermöglicht automatische Re-Registrierung beim Neustart des Containers.
ACCESS_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Anzeigename des Runners in GitHub (GitHub > Settings > Actions > Runners)
RUNNER_NAME=local-docker-runner

# Labels (kommasepariert) – müssen mit "runs-on" in den Workflow-Dateien übereinstimmen
RUNNER_LABELS=self-hosted,linux,x64
